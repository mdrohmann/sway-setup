#!/usr/bin/env python3
"""Screenshot a sway session with window contents blurred.

For publishing a screenshot of your desktop without publishing what is on it.
grim has no filters -- it captures and nothing else -- so the blur is a second
pass, here in Pillow.

The window rectangles come from sway's own IPC rather than being guessed, so
nothing on screen is missed and the bar is left alone: the bar is usually the
point of the picture, and it holds icons and numbers rather than anything you
would mind strangers reading.

    blur-shot                     capture, blur windows, keep the bar sharp
    blur-shot -o shot.png         write somewhere specific
    blur-shot --titles            also blur sway's title bars (see below)
    blur-shot --bar               crop to the bar; no blur, nothing to blur
    blur-shot --radius 24         blur harder

--titles matters more than it sounds. Sway draws the title bar *above* the
window rectangle, so it survives the default blur -- and named-term puts the
working directory in the title, so a terminal opened in ~/work/acme-merger
will publish that. Check what your titles say, or pass --titles.

The only dependency beyond grim and sway is Pillow: apt install python3-pil.

This is the odd one out in bin/ -- everything else here is POSIX sh, and this
is Python, because blurring an image in sh is not a thing anyone should do.
It is also not part of the desktop: nothing binds it, nothing execs it. It
lives here because it is what produced the screenshot in the README.
"""
import argparse
import json
import os
import subprocess
import sys
import tempfile

try:
    from PIL import Image, ImageFilter
except ImportError:
    sys.exit("blur-shot: needs Pillow -- sudo apt install python3-pil")

BAR_BG = (50, 50, 50)   # waybar's #323232, per config/waybar/style.css


def sway_tree():
    out = subprocess.run(["swaymsg", "-t", "get_tree", "--raw"],
                         capture_output=True, text=True, check=True).stdout
    return json.loads(out)


def visible_windows(node, blur_titles):
    """Rectangles of the windows sway says are on screen -- i.e. what grim got."""
    if (node.get("app_id") or node.get("window_props")) and node.get("visible"):
        r = node["rect"]
        yield r["x"], r["y"], r["width"], r["height"]
        # deco_rect is relative to the parent container and so cannot be used
        # directly, but a title bar always sits immediately above its window.
        deco = node.get("deco_rect") or {}
        if blur_titles and deco.get("height"):
            yield r["x"], r["y"] - deco["height"], r["width"], deco["height"]
    for key in ("nodes", "floating_nodes"):
        for child in node.get(key, []):
            yield from visible_windows(child, blur_titles)


def bar_height(im, limit=200):
    """Rows of bar background at the top. Beats hardcoding a height that
    changes with font size."""
    h = 0
    for y in range(min(limit, im.height)):
        row = [im.getpixel((x, y)) for x in range(0, im.width, 7)]
        if sum(p == BAR_BG for p in row) * 100 // len(row) < 60:
            break
        h = y + 1
    return h


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("-o", "--output", default="screenshot.png")
    ap.add_argument("--titles", action="store_true")
    ap.add_argument("--bar", action="store_true")
    ap.add_argument("--radius", type=int, default=16)
    ap.add_argument("--zoom", type=int, default=1)
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args()

    if args.help:
        print(__doc__.strip())
        return 0

    fd, raw = tempfile.mkstemp(suffix=".png", prefix="blur-shot-")
    os.close(fd)
    try:
        subprocess.run(["grim", raw], check=True)
        im = Image.open(raw).convert("RGB")

        if args.bar:
            h = bar_height(im)
            if not h:
                return "blur-shot: no bar found at the top of the screen"
            im = im.crop((0, 0, im.width, h))
            print(f"cropped to the bar: {im.width}x{h}")
        else:
            rects = list(visible_windows(sway_tree(), args.titles))
            # A bug in the tree walk must never mean an unblurred screenshot,
            # so fall back to blurring everything below the bar.
            if not rects:
                h = bar_height(im) or 0
                print("! no visible windows from IPC -- blurring all below the bar",
                      file=sys.stderr)
                rects = [(0, h, im.width, im.height - h)]

            for x, y, w, h in rects:
                x, y = max(0, x), max(0, y)
                w, h = min(w, im.width - x), min(h, im.height - y)
                if w > 0 and h > 0:
                    patch = im.crop((x, y, x + w, y + h))
                    im.paste(patch.filter(ImageFilter.GaussianBlur(args.radius)), (x, y))
                    print(f"blurred {w}x{h} at {x},{y}")

        if args.zoom > 1:
            im = im.resize((im.width * args.zoom, im.height * args.zoom),
                           Image.NEAREST)

        im.save(args.output, optimize=True)
        print(f"wrote {args.output}  ({im.width}x{im.height})")
    finally:
        os.unlink(raw)
    return 0


if __name__ == "__main__":
    sys.exit(main())
