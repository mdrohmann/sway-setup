#!/bin/sh
# Screenshot a sway session with window contents blurred.
#
# For publishing a picture of your desktop without publishing what is on it.
# grim has no filters -- it captures and nothing else -- so the blur is a
# second pass, here in ImageMagick.
#
# Window rectangles come from sway's own IPC rather than being guessed, so
# nothing on screen is missed, and the bar is left alone: the bar is usually
# the point of the picture and holds icons and numbers rather than anything
# you would mind strangers reading.
#
#   blur-shot                  capture, blur windows, keep the bar sharp
#   blur-shot -o shot.png      write somewhere specific
#   blur-shot --titles         also blur sway's title bars (read on)
#   blur-shot --bar            crop to the bar; no blur, nothing to blur
#   blur-shot --radius 24      blur harder (default 16)
#   blur-shot --zoom 3         enlarge, for a bar crop in a README
#
# --titles matters more than it sounds. Sway draws the title bar *above* the
# window rectangle, so it survives the default blur -- and named-term puts the
# working directory in the title, so a terminal opened in ~/work/acme-merger
# will publish that. Check what your titles say, or pass --titles.
#
# Needs grim, jq and ImageMagick. Nothing binds this script; it is not part of
# the desktop. It lives here because it made the screenshots in the README.

set -eu

RADIUS=16
ZOOM=1
TITLES=false
BAR_ONLY=no
OUT=screenshot.png

usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
    case $1 in
        -o|--output) OUT=${2:?-o needs a path}; shift 2 ;;
        --radius)    RADIUS=${2:?--radius needs a number}; shift 2 ;;
        --zoom)      ZOOM=${2:?--zoom needs a number}; shift 2 ;;
        --titles)    TITLES=true; shift ;;
        --bar)       BAR_ONLY=yes; shift ;;
        -h|--help)   usage; exit 0 ;;
        *) echo "blur-shot: unknown option '$1' (try --help)" >&2; exit 2 ;;
    esac
done

for c in grim jq magick; do
    command -v "$c" >/dev/null 2>&1 || {
        echo "blur-shot: needs $c" >&2; exit 1; }
done

RAW=$(mktemp --suffix=.png -t blur-shot-XXXXXX)
trap 'rm -f "$RAW"' EXIT INT TERM
grim "$RAW"

# The focused workspace's rect starts below the bar, so its y *is* the bar
# height. Better than sampling pixels: it does not care what colour the bar
# is, and it is right even when nothing is open.
BAR=$(swaymsg -t get_workspaces --raw | jq -r 'map(select(.focused))[0].rect.y')

set --
if [ "$BAR_ONLY" = yes ]; then
    [ "$BAR" -gt 0 ] 2>/dev/null || { echo "blur-shot: no bar at the top" >&2; exit 1; }
    WIDTH=$(magick identify -format '%w' "$RAW")
    set -- -crop "${WIDTH}x${BAR}+0+0" +repage
else
    # A view has a pid; containers and workspaces do not. That is the whole
    # test, and unlike matching on app_id it catches xwayland windows too.
    REGIONS=$(swaymsg -t get_tree --raw | jq -r --argjson titles "$TITLES" '
        .. | objects | select(.pid != null and .visible == true)
        | "\(.rect.width)x\(.rect.height)+\(.rect.x)+\(.rect.y)",
          # deco_rect is relative to the parent container and so cannot be
          # used as-is, but a title bar always sits on top of its window.
          (if $titles and ((.deco_rect.height // 0) > 0)
           then "\(.rect.width)x\(.deco_rect.height)+\(.rect.x)+\(.rect.y - .deco_rect.height)"
           else empty end)')

    # A bug in the query above must never mean an unblurred screenshot, so
    # fall back to blurring everything below the bar.
    if [ -z "$REGIONS" ]; then
        echo "blur-shot: no visible windows from sway -- blurring all below the bar" >&2
        HEIGHT=$(magick identify -format '%h' "$RAW")
        REGIONS="$(magick identify -format '%w' "$RAW")x$((HEIGHT - BAR))+0+$BAR"
    fi

    for r in $REGIONS; do
        set -- "$@" -region "$r" -blur "0x$RADIUS" +region
        echo "blurred $r"
    done
fi

[ "$ZOOM" -gt 1 ] 2>/dev/null && set -- "$@" -scale "$((ZOOM * 100))%"

magick "$RAW" "$@" "$OUT"
echo "wrote $OUT  ($(magick identify -format '%wx%h' "$OUT"))"
